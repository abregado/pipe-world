:root,
.skin-scope {
    --font-normal: resource('Fonts/TitilliumWeb-Regular');
    --font-semibold: resource('Fonts/TitilliumWeb-SemiBold');
    --font-bold: resource('Fonts/TitilliumWeb-Bold');
    --font-black: resource('Fonts/TitilliumWeb-Black');

    --color-text-main: white;
    --color-text-error: orangered;

    -unity-font-definition: var(--font-normal);
    color: var(--color-text-main);

    --fs-large: 24px;
    --fs-body: 18px;
    --fs-small: 13px;

    --fs-menu-large: 24px;
    --fs-menu-body: 18px;
    --fs-menu-small: 14px;

    --quest-w: 400px;
    --tooltip-w: 300px;
    --tooltip-w-wide: 440px;
    --tooltip-w-max: 340px;
    --status-w: 100px;

    /* Colour tokens. USS cannot derive an alpha from a colour, so each recurring tint has its own token. */

    --color-accent-a4: rgba(226, 181, 96, 0.04);
    --color-accent-a6: rgba(226, 181, 96, 0.06);
    --color-accent-a8: rgba(226, 181, 96, 0.08);
    --color-accent-a12: rgba(226, 181, 96, 0.12);
    --color-accent-a15: rgba(226, 181, 96, 0.15);
    --color-accent-a18: rgba(226, 181, 96, 0.18);
    --color-accent-a20: rgba(226, 181, 96, 0.2);
    --color-accent-a30: rgba(226, 181, 96, 0.3);
    --color-accent-a35: rgba(226, 181, 96, 0.35);
    --color-accent-a40: rgba(226, 181, 96, 0.4);
    --color-accent-a45: rgba(226, 181, 96, 0.45);
    --color-accent-a55: rgba(226, 181, 96, 0.55);
    --color-accent-a60: rgba(226, 181, 96, 0.6);
    --color-accent-a65: rgba(226, 181, 96, 0.65);
    --color-accent-a70: rgba(226, 181, 96, 0.7);
    --color-accent-a80: rgba(226, 181, 96, 0.8);
    --color-accent: #E2B560;

    --color-amber-a20: rgba(212, 168, 67, 0.2);
    --color-amber-a30: rgba(212, 168, 67, 0.3);
    --color-amber-a55: rgba(212, 168, 67, 0.55);
    --color-amber-a75: rgba(212, 168, 67, 0.75);

    --color-black-a30: rgba(0, 0, 0, 0.3);
    --color-black-a40: rgba(0, 0, 0, 0.4);
    --color-black-a60: rgba(0, 0, 0, 0.6);

    --color-cream: #F5EBD5;

    --color-negative: #C85040;

    --color-positive-a35: rgba(141, 179, 96, 0.35);
    --color-positive-a60: rgba(141, 179, 96, 0.6);
    --color-positive-a70: rgba(141, 179, 96, 0.7);
    --color-positive: #8DB360;

    --color-panel-a92: rgba(54, 38, 23, 0.92);

    --color-panel-amber-a97: rgba(55, 40, 8, 0.97);

    --color-panel-dark-a97: rgba(6, 4, 1, 0.97);

    --color-warn-a20: rgba(232, 130, 10, 0.2);
    --color-warn-a40: rgba(232, 130, 10, 0.4);
    --color-warn: #E8820A;

    --color-warn-soft: #E8922A;

    --color-white-a6: rgba(255, 255, 255, 0.06);
    --color-white-a30: rgba(255, 255, 255, 0.3);
    --color-white-a35: rgba(255, 255, 255, 0.35);
    --color-white-a40: rgba(255, 255, 255, 0.4);
    --color-white-a45: rgba(255, 255, 255, 0.45);
    --color-white-a60: rgba(255, 255, 255, 0.6);
    --color-white-a65: rgba(255, 255, 255, 0.65);
    --color-white-a70: rgba(255, 255, 255, 0.7);
    --color-white-a75: rgba(255, 255, 255, 0.75);

    --color-08161e: #2E2014;

    --color-120c02-a97: rgba(18, 12, 2, 0.97);

    --color-280806-a97: rgba(40, 8, 6, 0.97);

    --color-282a2c-a40: rgba(40, 42, 44, 0.4);

    --color-370f0c-a97: rgba(55, 15, 12, 0.97);

    --color-371250-a95: rgba(84, 38, 20, 0.95);

    --color-438cd4-a30: rgba(170, 118, 52, 0.3);

    --color-4a9ab5: #C9953F;

    --color-5a1e7d-a97: rgba(122, 60, 30, 0.97);

    --color-8c8c8c-a12: rgba(140, 140, 140, 0.12);
    --color-8c8c8c-a20: rgba(140, 140, 140, 0.2);

    --color-b4372d-a50: rgba(180, 55, 45, 0.5);

    --color-b94be6-a15: rgba(190, 92, 60, 0.15);
    --color-b94be6-a55: rgba(190, 92, 60, 0.55);

    --color-c83830: #C83830;

    --color-c83c2d-a80: rgba(200, 60, 45, 0.8);

    --color-c8eefa: #F6E6BE;

    --color-dc64ff-a15: rgba(214, 110, 70, 0.15);
    --color-dc64ff-a30: rgba(214, 110, 70, 0.3);
    --color-dc64ff-a35: rgba(214, 110, 70, 0.35);
    --color-dc64ff-a50: rgba(214, 110, 70, 0.5);
    --color-dc64ff-a55: rgba(214, 110, 70, 0.55);
    --color-dc64ff-a85: rgba(214, 110, 70, 0.85);

    --color-ebaaff: #F0C090;

    --color-ebb9ff-a95: rgba(235, 185, 255, 0.95);

    --color-ebc8ff: #F2D2B0;

    --color-f0a03c: #F0A03C;

    --color-fcdcff: #FFE6CC;

    --color-fd8c35: #FD8C35;

    --color-ff6b5b: #FF6B5B;

    --color-ffd2c8-a85: rgba(255, 210, 200, 0.85);
}

/* Smaller font tier; the :root defaults are the larger tier. */
:root.hud-font-normal,
.hud-font-normal {
    --fs-large: 21px;
    --fs-body: 16px;
    --fs-small: 12px;

    --quest-w: 320px;
    --tooltip-w: 250px;
    --tooltip-w-wide: 370px;
    --tooltip-w-max: 290px;
    --status-w: 88px;
}

.hudtext {
    font-size: var(--fs-body);
}

.hudtext-bold {
    -unity-font-definition: var(--font-bold);
    font-size: var(--fs-body);
}

.hudtext-large {
    -unity-font-definition: var(--font-semibold);
    font-size: var(--fs-large);
}

.hudtext-large-bold {
    -unity-font-definition: var(--font-bold);
    font-size: var(--fs-large);
}

Label {
    font-size: var(--fs-body);
}

/* ── Farm styling ─────────────────────────────────────────────────────────
   Warm wood, wheat and leaf colours come from the tokens above. These rules soften the hard angular
   panels: rounded corners, a wooden-sign logo and a plain, friendly letter spacing. */
.menu Button,
.menu-view-panel,
.menu-discord-cta,
.menu-status,
.menu-status #status-value {
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.menu-logo {
    color: #F2C468;
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.menu-divider,
.menu-divider-tight {
    height: 2px;
    border-top-left-radius: 1px;
    border-top-right-radius: 1px;
    border-bottom-left-radius: 1px;
    border-bottom-right-radius: 1px;
}
